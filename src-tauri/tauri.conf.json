{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Speaker Scribe",
  "version": "0.2.0",
  "identifier": "com.mlnavigator.speaker-scribe",
  "build": {
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": ["icons/icon.icns"],
    "copyright": "MIT licensed. Audio never leaves this machine.",
    "category": "Productivity",
    "shortDescription": "Local transcription with speaker turns",
    "longDescription": "Turns audio files into transcripts with speaker turns, entirely on this machine. No account, no API key, no upload.",
    "resources": {
      "../build/runtime/py": "runtime",
      "../build/models": "models",
      "../build/ffmpeg/bin/ffmpeg": "ffmpeg",
      "../backend/speaker_scribe_backend": "backend/speaker_scribe_backend",
      "../docs/legal": "legal",
      "../dist": "dist"
    },
    "macOS": {
      "minimumSystemVersion": "13.0",
      "entitlements": "entitlements.plist"
    }
  }
}
